# Optional. The Dropbox client ids are selected by host, so a build normally
# needs no configuration at all — this file is only for overriding them for a
# specific build.
#
# Two apps are used: development and production (D25). Setting a value here
# overrides the host selection for that build.
#
# These are OAuth client ids, which are public, not passwords. The Dropbox app
# secret must never appear in any VITE_ variable — anything prefixed VITE_ is
# bundled into the shipped JavaScript and served to anyone who loads the site.
#
# See specs/0001-plan.md section 6.6 for the console setup these correspond to.
VITE_DROPBOX_APP_KEY_PRODUCTION=
VITE_DROPBOX_APP_KEY_DEVELOPMENT=