tmp/
.tmp/
node_modules
dist
coverage
*.tsbuildinfo

# The app holds personal data. Nothing that could carry a document belongs in the
# repository, and nothing that could grant access to the Dropbox account does
# either. The Dropbox keys in src/sync/appKey.ts are OAuth *client ids*, which are
# public by construction and appear in the consent screen URL; the App secret is
# never present here (SEC5).
.env
.env.local
.env.*.local

# Playwright's scratch profile, if a run is interrupted.
test-results/
playwright-report/

# Generated by `npm run migrate:fixture` and by `npm run migrate:sqlite`.
# Both write a document the user is about to put in Dropbox, so neither is
# committed: it is personal data, and a committed copy would be stale.
scripts/migrate/fixture-out.json
scripts/migrate/fixture-out.json.report.json
scripts/migrate/out*.json
scripts/migrate/dry.json

# The default destination of `npm run migrate:sqlite` lands in the working
# directory, which is the repository root, and the report beside it. Listed by
# name because the defaults are fixed in the CLI; an `--out` elsewhere is the
# user's own path to choose.
/career-management-document.json
/career-management-document.json.report.json

# Reference PDFs the user supplied for a formatting comparison.
*.pdf
